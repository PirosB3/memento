# Database — PostgreSQL connection string
# Dev:  postgresql://summon:summon@localhost:5432/summon_dev
# Test: postgresql://summon:summon@localhost:5432/summon_test
# Prod: set via deployment platform (e.g. Neon, Supabase, RDS)
DATABASE_URL="postgresql://summon:summon@localhost:5432/summon_dev"

# API keys
ANTHROPIC_API_KEY=
AGENTMAIL_API_KEY=

# Optional
OPENAI_API_KEY=

# Owner identity — used as default when creating agents and referenced in
# examples/docs. Set these to your own name and email for local development.
OWNER_NAME=
OWNER_EMAIL=
