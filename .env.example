# Database — PostgreSQL connection string
# Dev:  postgresql://summon:summon@localhost:5432/summon_dev
# Test: postgresql://summon:summon@localhost:5432/summon_test
# Prod: set via deployment platform (e.g. Neon, Supabase, RDS)
DATABASE_URL="postgresql://summon:summon@localhost:5432/summon_dev"

# API keys
ANTHROPIC_API_KEY=
AGENTMAIL_API_KEY=
# Required: used to generate agent avatars (gpt-image-1) during agent creation.
OPENAI_API_KEY=

# Cloudflare R2 — hosts generated agent avatars at pfps/{agentId}.png.
# The public URL serves images directly to email clients.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memento
R2_PUBLIC_URL=

# Owner identity — used as default when creating agents and referenced in
# examples/docs. Set these to your own name and email for local development.
OWNER_NAME=
OWNER_EMAIL=

# Company identity — rendered in every agent's outbound email signature.
COMPANY_NAME=
COMPANY_WEBSITE=
